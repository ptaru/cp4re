{
  "name": "scrypted-cp4-camera",
  "version": "0.0.5",
  "private": true,
  "description": "On-demand CP4 LAN wake and SD video server proof of concept",
  "scripts": {
    "build": "scrypted-webpack",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test/test/*.js",
    "scrypted-deploy": "scrypted-deploy",
    "test:bundle": "npm run build && node --test test/bundle.cjs",
    "test:media": "node --test test/media.cjs"
  },
  "scrypted": {
    "name": "CP4 LAN Camera PoC",
    "type": "Camera",
    "interfaces": [
      "VideoCamera",
      "Settings"
    ],
    "pluginDependencies": [
      "@scrypted/prebuffer-mixin",
      "@scrypted/snapshot",
      "@scrypted/webrtc"
    ]
  },
  "devDependencies": {
    "@scrypted/sdk": "0.5.59",
    "@types/node": "^22.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.7.0",
    "webpack": "^5.112.2",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
